---
import '../styles/global.css'
import BaseHead from '../components/layout/BaseHead.astro'
import Footer from '../components/layout/Footer.astro'
import ThemeToggle from '../components/layout/ThemeToggle.astro'
import { site } from '../data/site'
import type { JsonLd } from '../utils/seo'

type LayoutProps = {
  title?: string
  description?: string
  image?: string
  type?: 'website' | 'article'
  noindex?: boolean
  jsonLd?: JsonLd | JsonLd[]
}

const {
  title = `${site.name} — Monitoring Latihan Competitive Programming`,
  description = site.description,
  image = '/og.png',
  type,
  noindex,
  jsonLd,
}: LayoutProps = Astro.props

const navItems = [
  { label: 'Statistik', href: '/', target: 'statistics' },
  { label: 'Referensi Belajar', href: '/learn/references', target: 'references' },
  { label: 'Platform Belajar', href: '/learn/platforms', target: 'platforms' },
]
---

<!doctype html>
<html lang={site.locale}>
  <head>
    <BaseHead
      title={title}
      description={description}
      image={image}
      type={type}
      noindex={noindex}
      jsonLd={jsonLd}
    />
  </head>
  <body>
    <a class="skip-link" href="#konten-utama">
      Lewati ke konten
    </a>
    <div class="page page-grid">
      <aside class="sidebar" id="sidebar" aria-label="Navigasi utama">
        <button class="sidebar__close" type="button" data-sidebar-close aria-label="Tutup menu">
          <span aria-hidden="true">×</span>
        </button>

        <a class="sidebar__brand" href="/">
          <span class="sidebar__brand-mark" aria-hidden="true">
            <img
              src="/jtk-polban-light.png"
              alt=""
              class="sidebar__brand-logo logo-variant-dark"
              width="42"
              height="42"
            />
            <img
              src="/jtk-polban-dark.png"
              alt=""
              class="sidebar__brand-logo logo-variant-light"
              width="42"
              height="42"
            />
          </span>
          <span class="sidebar__brand-text">
            <strong>{site.name}</strong>
            <small>Monitoring latihan CP</small>
          </span>
        </a>

        <nav class="sidebar__nav">
          {navItems.map((item) => (
            <a href={item.href} data-nav-link data-target={item.target}>
              {item.label}
            </a>
          ))}
        </nav>

        <div class="sidebar__cta">
          <p class="sidebar__note">{site.description}</p>
        </div>
      </aside>

      <div class="page-content">
        <main id="konten-utama">
          <slot />
        </main>
        <Footer />
      </div>

      <div class="sidebar-overlay" data-sidebar-overlay></div>
    </div>

    <div class="global-toggles">
      <button
        class="sidebar-toggle"
        type="button"
        data-sidebar-toggle
        aria-controls="sidebar"
        aria-expanded="false"
        aria-label="Buka menu">
        <svg viewBox="0 0 24 24" aria-hidden="true" class="sidebar-toggle__icon">
          <path
            d="M4 7h16M4 12h16M4 17h16"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
          />
        </svg>
      </button>
      <div class="global-toggles__controls">
        <ThemeToggle />
      </div>
    </div>

    <script>
      import { initHeaderControls } from '../scripts/header-controls'
      import { initSidebar } from '../scripts/sidebar'

      const init = () => {
        initHeaderControls()
        initSidebar()
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init, { once: true })
      } else {
        init()
      }
    </script>
  </body>
</html>

<style>
  .global-toggles {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    position: fixed;
    top: 1rem;
    right: 1.25rem;
    z-index: 20000;
    background: transparent;
    border: none;
    padding: 0;
  }

  .global-toggles__controls {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .page-grid {
    display: grid;
    grid-template-columns: 260px 1fr;
    min-height: 100svh;
    position: relative;
  }

  .sidebar {
    position: sticky;
    top: 0;
    align-self: start;
    height: 100svh;
    max-height: 100svh;
    padding: 2rem 1.5rem;
    background: var(--sidebar-bg);
    border-right: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    overflow-y: auto;
  }

  .sidebar__brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--text);
    text-decoration: none;
    min-width: 0;
  }

  .sidebar__brand-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .sidebar__brand-logo {
    width: 2.65rem;
    height: 2.65rem;
    object-fit: contain;
  }

  .sidebar__brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
    min-width: 0;
  }

  .sidebar__brand-text strong {
    font-size: 0.95rem;
    font-weight: 700;
  }

  .sidebar__brand-text small {
    color: var(--muted);
    font-size: 0.72rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .sidebar__nav {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .sidebar__nav a {
    display: flex;
    align-items: center;
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-md);
    color: var(--muted);
    font-weight: 500;
    font-size: 0.875rem;
    transition:
      background 0.15s ease,
      color 0.15s ease;
  }

  .sidebar__nav a:hover,
  .sidebar__nav a.active {
    background: var(--surface-muted);
    color: var(--text);
  }

  .sidebar__cta {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .sidebar__note {
    margin: 0;
    font-size: 0.75rem;
    line-height: 1.55;
    color: var(--muted);
  }

  .page-content {
    display: flex;
    flex-direction: column;
    padding: 0;
    min-width: 0;
  }

  .page-content > main {
    flex: 1 0 auto;
  }

  .sidebar-toggle {
    display: none;
    justify-content: center;
    padding: 0;
    border-radius: var(--radius-md);
    background: var(--bg);
    color: var(--text);
    border: 1px solid var(--border);
    align-items: center;
    white-space: nowrap;
    flex-shrink: 0;
    width: 2.5rem;
    height: 2.5rem;
    cursor: pointer;
  }

  .sidebar-toggle__icon {
    width: 1.25rem;
    height: 1.25rem;
  }

  .sidebar-overlay {
    display: none;
  }

  .sidebar__close {
    display: none;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    margin: -0.5rem -0.5rem 0.5rem auto;
    border-radius: var(--radius-md);
    border: none;
    background: transparent;
    color: var(--muted);
    transition: color 0.15s ease;
    cursor: pointer;
  }

  .sidebar__close:hover {
    color: var(--text);
  }

  .sidebar__close span[aria-hidden='true'] {
    font-size: 1.5rem;
    line-height: 1;
    font-weight: 300;
  }

  @media (max-width: 1100px) {
    .page-grid {
      grid-template-columns: 240px 1fr;
    }
  }

  @media (max-width: 900px) {
    :global(html.sidebar-open) {
      overflow: hidden;
    }

    .global-toggles {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      width: 100%;
      padding: 0.5rem 1rem;
      background: var(--bg);
      border-bottom: 1px solid var(--border);
      justify-content: space-between;
      z-index: 20000;
      gap: 0.75rem;
      border-radius: 0;
    }

    .global-toggles__controls {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      flex: 1;
      justify-content: flex-end;
      flex-wrap: wrap;
    }

    .page-grid {
      grid-template-columns: 1fr;
    }

    .sidebar {
      position: fixed;
      inset: 0;
      height: 100lvh;
      max-height: 100lvh;
      padding: 1.5rem;
      padding-top: 4.5rem;
      overflow-y: auto;
      -webkit-overflow-scrolling: touch;
      transform: translateX(-100%);
      transition: transform 0.25s ease;
      z-index: 19000;
      background: var(--sidebar-bg);
    }

    .sidebar-toggle {
      display: inline-flex;
    }

    .sidebar-overlay {
      display: block;
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.5);
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.25s ease;
      z-index: 18900;
    }

    :global(html.sidebar-open) .sidebar {
      transform: translateX(0);
    }

    :global(html.sidebar-open) .sidebar-overlay {
      opacity: 1;
      pointer-events: auto;
    }

    .page-content {
      padding-top: 3.6rem;
      min-width: 0;
    }

    .sidebar__close {
      display: inline-flex;
    }

    .sidebar__nav a {
      padding: 0.75rem 1rem;
      font-size: 1rem;
    }
  }
</style>
