---
import fs from 'node:fs'
import path from 'node:path'
import { getCollection } from 'astro:content'
import DashboardPage from '../../components/layout/DashboardPage.astro'
import CpDashboard from '../../components/cp/CpDashboard.vue'
import { site } from '../../data/site'
import { createEmptyCpData } from '../../utils/cp/empty'
import { buildBreadcrumbSchema, normalizeSiteUrl } from '../../utils/seo'
import { t as locale } from '../../utils/i18n'
import '../../styles/cp-shared.css'
import type { CpData } from '../../types/cp.types'
import type { StudentRoster } from '../../types/student.types'

export async function getStaticPaths() {
  const students = await getCollection('students')

  return students.map((entry) => ({
    params: { nim: entry.data.nim },
    props: { student: entry.data as StudentRoster },
  }))
}

const { student } = Astro.props
const siteUrl = normalizeSiteUrl(Astro.site)

const snapshotPath = path.join(process.cwd(), 'src', 'data', 'students', `${student.nim}.json`)
const snapshot: CpData =
  fs.existsSync(snapshotPath) ?
    (JSON.parse(fs.readFileSync(snapshotPath, 'utf8')) as CpData)
  : createEmptyCpData(student.nim)

const isD3 = student.kelas.toUpperCase().includes('D3') || student.nim.slice(4, 6) === '11'
const prodi = isD3 ? 'D3' : 'D4'
const isAlumni = student.aktif === false || student.kelas.toLowerCase().includes('alumni')
const angkatan = student.nim.slice(0, 2)
const rombel = student.kelasHuruf || 'A'

const title = `${student.nama} — ${site.name}`
const subTitle =
  isAlumni ? `Alumni ${angkatan}, Kelas ${rombel}-${prodi}` : `Kelas ${student.kelas}`
const metaDescription = `Profil dan capaian latihan competitive programming ${student.nama} (${subTitle}) di TLX, Codeforces, dan LeetCode.`

const jsonLd = buildBreadcrumbSchema(siteUrl, [
  { name: 'Dashboard', path: '/' },
  { name: student.nama, path: `/students/${student.nim}/` },
])
---

<DashboardPage
  metaTitle={title}
  metaDescription={metaDescription}
  metaJsonLd={jsonLd}
  heading={locale(student.nama, student.nama)}
  description={locale(subTitle, subTitle)}
  backHref="/"
  backLabel={locale('← Kembali ke dashboard', '← Kembali ke dashboard')}
  headerClass="cp-header">
  <CpDashboard client:load initialData={snapshot} />
</DashboardPage>

<style>
  .student-meta {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 1.5rem;
    padding: 1rem 1.15rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    background: var(--bg-soft);
  }

  .student-meta__identity {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.25rem;
    font-size: 0.82rem;
    color: var(--muted);
  }

  .student-meta__identity strong {
    color: var(--text);
    font-weight: 700;
  }

  .student-meta__platforms {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .platform-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.35rem 0.7rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--bg-elevated);
    font-size: 0.75rem;
    font-weight: 600;
  }

  .platform-pill.is-muted {
    color: var(--muted);
  }

  .platform-pill a {
    color: var(--text);
    text-decoration: none;
  }

  .platform-pill a:hover {
    text-decoration: underline;
  }

  .platform-pill a span {
    color: var(--muted);
    font-weight: 500;
  }

  .platform-pill__logo {
    width: 0.95rem;
    height: 0.95rem;
    object-fit: contain;
    flex-shrink: 0;
  }
</style>
